# Copiare queste righe nella .htaccess remota e sostituire i placeholder.
# Il file distribuito sul server deve restare privato e non va ricopiato nel progetto.
SetEnv REMOTE_DB_DSN "mysql:host=localhost;dbname=my_ACCOUNT;charset=utf8mb4"
SetEnv REMOTE_DB_USER "ACCOUNT"
SetEnv REMOTE_DB_PASSWORD "<password-database-altervista>"
SetEnv REMOTE_API_SECRET "<segreto-api-almeno-32-caratteri>"
SetEnv REMOTE_CURSOR_SECRET "<segreto-cursori-diverso-almeno-32-caratteri>"
SetEnv REMOTE_CURSOR_TTL_SECONDS "900"
SetEnv REMOTE_DB_CONNECT_TIMEOUT_SECONDS "3"
SetEnv REMOTE_DB_QUERY_TIMEOUT_SECONDS "8"
