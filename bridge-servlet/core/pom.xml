<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><parent><groupId>it.unibg.driveaura</groupId><artifactId>bridge-servlet</artifactId><version>0.1.0</version></parent>
  <artifactId>bridge-core</artifactId><packaging>jar</packaging><properties><maven.compiler.release>8</maven.compiler.release></properties>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/../../shared</directory>
        <includes><include>entity-schema.json</include></includes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../../tests/fixtures</directory>
        <includes>
          <include>t03-dataset.json</include>
          <include>patologia-canonical.json</include>
          <include>patologia-empty.json</include>
          <include>patologia-line-separators.json</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><failIfNoTests>true</failIfNoTests></configuration>
      </plugin>
    </plugins>
  </build>
</project>
